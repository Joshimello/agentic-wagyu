# OpenAI-compatible gateway used for development testing.
OPENAI_API_KEY=replace_with_your_api_key
OPENAI_MODEL=pro6000/qwen38-flash-next
OPENAI_BASE_URL=https://llm.igvi.cs.nthu.edu.tw

# Select a device listed by nvidia-ctk cdi list. WSL exposes nvidia.com/gpu=all.
NVIDIA_CDI_DEVICE=nvidia.com/gpu=0

# Shared across retries of one worker operation; 0 disables a limit.
LLM_MAX_CALLS_PER_OPERATION=300
LLM_MAX_INPUT_TOKENS_PER_OPERATION=2000000
LLM_MAX_OUTPUT_TOKENS_PER_OPERATION=200000
# No daily quota by default for the self-hosted gateway.
LLM_DAILY_TOKEN_LIMIT=0
# Optional actual API prices. Leave unset when unknown; self-hosted billing may be 0.
# LLM_INPUT_USD_PER_MILLION=0
# LLM_OUTPUT_USD_PER_MILLION=0
