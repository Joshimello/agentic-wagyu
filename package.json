{
  "name": "chronicler",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "test:contracts": "bun test apps/web/tests/contracts.test.ts",
    "check": "bun run --cwd apps/web check",
    "build": "bun run --cwd apps/web build",
    "test": "bun test apps/web/tests/*.test.ts",
    "test:foundation": "bun test apps/web/tests/persistence.test.ts",
    "test:llm:live": "bun apps/web/tests/llm-live.ts",
    "eval:interpreter:video": "bun apps/web/tests/video-live.ts",
    "import:recordings": "bun apps/web/tools/import-recordings.ts",
    "format": "bunx --bun prettier --write apps/web/src apps/web/workers apps/web/tests",
    "import:documents": "bun apps/web/tools/import-documents.ts",
    "eval:interpreter:documents": "bun apps/web/tests/documents-live.ts",
    "eval:chronicler:weekly": "bun apps/web/tools/push-weekly.ts",
    "eval:memory:integrity": "bun apps/web/tools/check-memory.ts",
    "eval:chronicler:organized": "bun apps/web/tools/organize-weekly.ts",
    "eval:researcher": "bun apps/web/tools/evaluate-researcher.ts",
    "verify:mvp": "bun apps/web/tools/verify-mvp.ts"
  },
  "dependencies": {
    "zod": "4.3.6"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1"
  }
}
