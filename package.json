{
  "name": "chronicler",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "check": "bun run --cwd apps/web check",
    "build": "bun run --cwd apps/web build",
    "test": "bun apps/web/tests/run.ts unit",
    "test:integration": "bun apps/web/tests/run.ts integration",
    "test:e2e": "bun run --cwd apps/web test:browser",
    "test:workflow": "bun evals/lifecycle/run.ts",
    "eval:interpreter:video": "bun evals/interpreter/video.ts",
    "eval:interpreter:documents": "bun evals/interpreter/documents.ts",
    "eval:organization": "bun evals/organization/run.ts",
    "eval:memory:integrity": "bun apps/web/tools/check-memory.ts",
    "eval:researcher": "bun evals/researcher/run.ts",
    "import:recordings": "bun evals/interpreter/import-recordings.ts",
    "import:documents": "bun evals/interpreter/import-documents.ts",
    "format": "prettier --write apps/web/src apps/web/workers apps/web/tests apps/web/tools evals --ignore-path .gitignore"
  },
  "dependencies": {
    "zod": "4.3.6"
  },
  "devDependencies": {
    "drizzle-orm": "0.45.3",
    "fflate": "0.8.2",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1"
  }
}
